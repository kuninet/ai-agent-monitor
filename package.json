{
  "name": "ai-agent-monitor",
  "version": "1.2.0",
  "description": "Claude Code / Antigravity(agy) の稼働状況ダッシュボード",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "ai-agent-monitor": "src/server.js"
  },
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning src/server.js",
    "snapshot": "node --no-warnings=ExperimentalWarning src/server.js --json",
    "setup-statusline": "node src/setup-statusline.js",
    "test": "node --test 'tests/**/*.test.js'",
    "test:e2e": "playwright test",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix src/",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/cli": "^0.1.21",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9"
  }
}
